{
  "name": "devlensio",
  "version": "1.0.0",
  "description": "Codebase intelligence engine for TypeScript/JavaScript/React/Next.js, Python, Java, Go, and Rust repositories.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "start": "bun src/server/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "test": "bun test",
    "export-graph": "bun src/debug/exportGraph.ts",
    "prepack": "node extractors/java/build.mjs && node extractors/go/build.mjs && node extractors/rust/build.mjs",
    "postinstall": "node extractors/python/setup.mjs"
  },
  "keywords": ["codebase", "graph", "ast", "typescript", "javascript", "devtools"],
  "author": "",
  "license": "AGPL-3.0",
  "files": [
    "dist/**/*",
    "extractors/java/**",
    "!extractors/java/classes",
    "!extractors/java/lib",
    "!extractors/java/sources.txt",
    "extractors/python/**",
    "!extractors/python/.venv",
    "!extractors/python/*.egg-info",
    "!extractors/python/**/__pycache__",
    "extractors/go/**",
    "!extractors/go/tests",
    "extractors/rust/**",
    "!extractors/rust/tests",
    "!extractors/rust/target",
    "!extractors/rust/Cargo.lock",
    "!extractors/python/tests",
    "!extractors/java/tests"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@google/genai": "^2.8.0",
    "dotenv": "^17.4.2",
    "openai": "^6.42.0",
    "simple-git": "^3.36.0",
    "ts-morph": "^28.0.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/uuid": "^11.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}